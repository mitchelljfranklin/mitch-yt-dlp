<Window x:Class="MitchYtDlp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:MitchYtDlp.Helpers"
        mc:Ignorable="d"
        Title="Mitch YT-DLP Downloader"
        Width="640" Height="440"
        MinWidth="520" MinHeight="370"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Icon="pack://application:,,,/icon.ico"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MitchYtDlp;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="Mitch YT-DLP Downloader" Style="{StaticResource HeaderLabel}"/>

        <Label Grid.Row="1" Content="Output Folder" Style="{StaticResource FieldLabel}"/>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     Padding="10,8"
                     Background="#2d2d2d"
                     Foreground="#e0e0e0"
                     BorderThickness="1"
                     BorderBrush="#444"
                     CaretBrush="#e0e0e0"
                     FontSize="13"/>
            <Button Grid.Column="1"
                    Content="Browse"
                    Style="{StaticResource StartButton}"
                    Command="{Binding BrowseCommand}"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>
        </Grid>

        <Label Grid.Row="3" Content="Video URL" Style="{StaticResource FieldLabel}"/>

        <TextBox Grid.Row="4"
                 Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                 Padding="10,8"
                 Background="#2d2d2d"
                 Foreground="#e0e0e0"
                 BorderThickness="1"
                 BorderBrush="#444"
                 CaretBrush="#e0e0e0"
                 FontSize="13"
                 Margin="0,0,0,4"
                 KeyDown="UrlTextBox_KeyDown"/>

        <CheckBox Grid.Row="5"
                  Content="Convert to MP3"
                  IsChecked="{Binding IsMp3Mode}"
                  Foreground="#e0e0e0"
                  FontSize="13"
                  Margin="0,4,0,0"/>

        <Label Grid.Row="6" Content="Extracts audio with FFmpeg" Style="{StaticResource HintLabel}"/>

        <Separator Grid.Row="7" Margin="0,12,0,8" Background="#444" Height="1"/>

        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Stop"
                    Style="{StaticResource StopButton}"
                    Command="{Binding StopCommand}"/>
            <Button Grid.Column="2"
                    Content="Exit"
                    Style="{StaticResource ExitButton}"
                    Command="{Binding ExitCommand}"/>
            <Button Grid.Column="4"
                    Content="Start"
                    Style="{StaticResource StartButton}"
                    Command="{Binding StartCommand}"/>
        </Grid>

        <Label Grid.Row="9"
               Content="{Binding PlaylistText}"
               Style="{StaticResource StatusLabel}"
               Visibility="{Binding PlaylistText, Converter={StaticResource StringToVisibilityConverter}}"
               Margin="0,0,0,2"/>

        <Grid Grid.Row="10" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="1"
                         Value="{Binding ProgressPercent}"
                         Maximum="100"
                         Style="{StaticResource ProgressBarStyle}"/>

            <Label Grid.Row="2"
                   Content="{Binding StatusMessage}"
                   Style="{StaticResource StatusLabel}"
                   Margin="0,2,0,0"/>
        </Grid>

        <Button Grid.Row="11"
                Content="{Binding UpdateButtonText}"
                Style="{StaticResource UpdateButton}"
                Command="{Binding CheckUpdateCommand}"
                HorizontalAlignment="Center"
                Margin="0,4,0,8"/>
    </Grid>
</Window>
